{
  "name": "ai-usage-dashboard",
  "version": "0.12.0",
  "private": true,
  "description": "Local dashboard for Claude Code and Codex token usage, estimated cost, and runtime.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 7842",
    "dev:lan": "next dev -H 0.0.0.0 -p 7842",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 7842",
    "start:lan": "next start -H 0.0.0.0 -p 7842",
    "typecheck": "tsc --noEmit",
    "parse": "tsx scripts/dump-usage.ts",
    "parse:codex": "tsx scripts/dump-codex-usage.ts",
    "demo:data": "tsx scripts/make-demo-data.ts",
    "demo:shots": "tsx scripts/make-screenshots.ts",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "geist": "^1.7.2",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
