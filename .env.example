# Copy to .env.local (which is gitignored) and fill in. Restart the server
# after changing anything here.

# Required. The dashboard refuses every request until this is set - it fails
# closed, so a missing value locks the door rather than opening it.
#
# Rotating it signs every device out, because session cookies are keyed off it.
DASHBOARD_PASSWORD=

# Strongly recommended before using `npm run start:lan` (or -Lan / DASHBOARD_LAN=1).
#
# A long random value mixed into the session-cookie key. Without it, someone who
# captures a cookie on your network can try password guesses offline; with it,
# a captured cookie is useless. Changing it also signs every device out.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
