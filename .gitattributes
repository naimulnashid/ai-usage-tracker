# Normalise to LF in the repository and in the working tree.
#
# Without this, a Windows checkout (core.autocrlf=true) writes CRLF while the
# repository stores LF, and Prettier - configured for LF - rewrites every line
# of every file it touches. The diff then shows whole files changed when one
# comment moved.
* text=auto eol=lf

# Windows scripts are the exception: cmd.exe and WSH want CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.vbs text eol=crlf

# Never touched, never diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
